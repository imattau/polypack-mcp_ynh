#!/bin/bash

source "$(dirname "$0")/_common.sh"
source /usr/share/yunohost/helpers

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progression "Stopping $app's systemd service..."
ynh_systemctl --service="$app" --action="stop"

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."
ynh_setup_source --dest_dir="$install_dir" --full_replace
polypack_mcp_remove_upstream_runtime_artifacts

#=================================================
# REINSTALL PYTHON VIRTUAL ENVIRONMENT
#=================================================
ynh_script_progression "Updating the Python virtual environment..."
polypack_mcp_install_venv

#=================================================
# PRESERVE RUNTIME POLICY
#=================================================
limit_bytes="$(sed -n 's/^POLYPACK_MCP_STORAGE_LIMIT_BYTES=//p' "$(polypack_mcp_runtime_env_file)" 2>/dev/null || true)"
if [ -z "$limit_bytes" ] || [ "$limit_bytes" = "0" ]; then
	limit_bytes=$((2 * 1024 * 1024 * 1024))
fi
polypack_mcp_prepare_data_dir
polypack_mcp_write_runtime_env "$limit_bytes"
polypack_mcp_register_embedding_service

#=================================================
# REAPPLY SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Updating system configurations related to $app..."
ynh_config_add_systemd
yunohost service add "$app" --description="Local Polypack MCP memory service"

#=================================================
# START APP
#=================================================
ynh_script_progression "Starting $app's systemd service..."
ynh_systemctl --service="$app" --action="start" \
	--log_path="systemd" \
	--wait_until="Uvicorn running on"

ynh_print_info "Local MCP endpoint: http://127.0.0.1:$port/mcp/"
ynh_script_progression "Upgrade of $app completed"
